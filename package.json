{
  "name": "@beel_es/mcp",
  "version": "0.1.0",
  "description": "BeeL Model Context Protocol server — invoicing tools derived from the OpenAPI spec, docs search, and Spanish fiscal guardrails (VeriFactu, NIF, corrective invoices).",
  "type": "module",
  "bin": {
    "beel-mcp": "./dist/index.js",
    "beel-mcp-http": "./dist/serve-http.js"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/build-ui.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "dev": "node scripts/build-ui.mjs && tsx src/index.ts",
    "dev:http": "node scripts/build-ui.mjs && tsx src/serve-http.ts",
    "start:http": "node dist/serve-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:oauth": "tsx scripts/oauth-e2e.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "sync:spec": "node scripts/bundle-spec.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beel-es/beel-mcp.git"
  },
  "keywords": [
    "beel",
    "mcp",
    "model-context-protocol",
    "invoicing",
    "verifactu",
    "api",
    "openapi",
    "llm",
    "agents"
  ],
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
