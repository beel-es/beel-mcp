{
  "name": "@beel_es/mcp",
  "version": "0.1.0",
  "description": "MCP server for the BeeL invoicing API \u2014 VeriFactu-compliant electronic invoicing tools for LLM agents, derived from the public OpenAPI contract.",
  "bin": {
    "beel-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "openapi",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/build-mcpapp.mjs",
    "build:mcpapp": "node scripts/build-mcpapp.mjs",
    "dev": "node scripts/build-mcpapp.mjs && tsx --import ./scripts/text-loader.mjs src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cf.json --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "sync:spec": "node scripts/bundle-spec.mjs",
    "spec:lock": "node scripts/spec-lock.mjs --write",
    "spec:verify": "node scripts/spec-lock.mjs",
    "tools:catalog": "tsx --import ./scripts/text-loader.mjs scripts/gen-tools-catalog.mts",
    "tools:list": "tsx --import ./scripts/text-loader.mjs scripts/list-tools.mts",
    "prepublishOnly": "npm run build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beel-es/beel-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "verifactu",
    "facturacion-electronica",
    "einvoicing",
    "invoicing",
    "spain",
    "aeat",
    "llm",
    "agents",
    "claude",
    "openapi",
    "beel"
  ],
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "^0.17.4",
    "ajv": "^8.20.0",
    "hono": "^4.13.1",
    "jose": "^5.10.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@redocly/cli": "^1.25.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "pdfjs-dist": "^4.10.38",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.120.1"
  },
  "homepage": "https://github.com/beel-es/beel-mcp#readme",
  "bugs": {
    "url": "https://github.com/beel-es/beel-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
