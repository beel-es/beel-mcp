{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beel-mcp",
  "main": "src/cf/worker.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // Builds the viewer HTML (dist/mcpapp/invoice-pdf.html) BEFORE bundling:
  // worker.ts imports it as a Text module. pdf.js is loaded from a CDN, not here.
  "build": { "command": "node scripts/build-mcpapp.mjs" },

  // The OpenAPI spec and the viewer HTML are embedded as Text modules.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml", "**/*.html", "**/*.md"], "fallthrough": true }],

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BeelMcpAgent"] }],
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "BeelMcpAgent" }]
  },

  // Create your own namespace with `npx wrangler kv namespace create OAUTH_KV`
  // and paste the id it prints here (or keep deployment-specific ids in a private
  // config passed with `wrangler deploy -c`). See DEPLOY.md.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<your-kv-namespace-id>" }],

  "observability": { "enabled": true },

  // Public vars only. Secrets (BEEL_OAUTH_CLIENT_SECRET, MCP_IDENTITY_HMAC_KEY)
  // go through `wrangler secret put`, never in this file. Deployment-specific
  // infrastructure (BEEL_PDF_STORAGE_HOSTS, routes) belongs to your own config.
  "vars": {
    "BEEL_OAUTH_ISSUER": "https://app.beel.es/api",
    "BEEL_OAUTH_CLIENT_ID": "beel-mcp",
    "BEEL_BASE_URL": "https://app.beel.es/api",
    "BEEL_DOCS_URL": "https://docs.beel.es"
  }
}
